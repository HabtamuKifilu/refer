// Rewardo database schema.
//
// Design notes live in docs/architecture.md. In short:
//   - User          accounts, each with a unique unguessable referral code
//   - ReferralClick  anonymous click log, powers attribution
//   - Referral       the referrer -> referred relationship and its lifecycle
//   - Reward         one $500 payout per qualified referral (unique constraint)
//   - ReferralEvent  append-only audit trail of everything that happened
//
// Enums are native Postgres enums. Money is stored in integer paise-free
// whole USD amounts for V1 (amount is stored as a whole-number value), avoiding float rounding.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ReferralStatus {
  CLICKED
  REGISTERED
  QUALIFIED
  COMPLETED
  REJECTED
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ReferralEventType {
  REFERRAL_CLICKED
  USER_REGISTERED
  REFERRAL_QUALIFIED
  REFERRAL_COMPLETED
  REFERRAL_REJECTED
  REWARD_CREATED
  REWARD_APPROVED
  REWARD_REJECTED
  REWARD_PAID
}

enum PackageRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
  OTHER
}

enum PackageStatus {
  ACTIVE
  TERMINATED
  REFUNDED
  REPLACED
}

model PackagePlan {
  id               String           @id @default(cuid())
  vipLevel         Int              @unique
  packageAmountBv  Decimal          @db.Decimal(18, 3)
  dailyProfitShare Decimal          @db.Decimal(18, 3)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  packageRequests  PackageRequest[]
  packages         UserPackage[]

  @@index([vipLevel])
}

model PackageRequest {
  id            String               @id @default(cuid())
  userId        String
  packagePlanId String
  status        PackageRequestStatus @default(PENDING)

  requestedVipLevel Int
  amountPayableBv   Decimal @db.Decimal(18, 3)
  upgradeCreditBv   Decimal @default(0) @db.Decimal(18, 3)
  amountPaidBv      Decimal @db.Decimal(18, 3)

  paymentReference       String
  paymentDate            DateTime
  paymentMethod          PaymentMethod
  paymentReceiptUrl      String
  paymentReceiptName     String?
  paymentReceiptMimeType String?
  paymentReceiptSize     Int?
  paymentNote            String?

  requestedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  cancelledAt      DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package UserPackage?

  packagePlan PackagePlan @relation(fields: [packagePlanId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedVipLevel])
  @@index([requestedAt])
}

model UserPackage {
  id               String @id @default(cuid())
  userId           String
  packagePlanId    String
  packageRequestId String @unique

  vipLevel           Int
  packageAmountBv    Decimal       @db.Decimal(18, 3)
  dailyProfitShareBv Decimal       @db.Decimal(18, 3)
  status             PackageStatus @default(ACTIVE)

  activatedAt  DateTime
  terminatedAt DateTime?
  replacedAt   DateTime?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packagePlan    PackagePlan    @relation(fields: [packagePlanId], references: [id])
  packageRequest PackageRequest @relation(fields: [packageRequestId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([vipLevel])
  @@index([activatedAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  referralCode String   @unique

  // Profile fields. The qualifying action is "complete your profile", which
  // means providing a phone number (name is required at registration).
  phone           String?
  profileComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Referrals where this user is the one doing the referring.
  referralsMade    Referral[] @relation("Referrer")
  // The single referral where this user is the one who was referred. A user
  // can only ever be referred once, enforced by @unique on referredUserId.
  referralReceived Referral?  @relation("ReferredUser")

  packageRequests PackageRequest[]
  packages        UserPackage[]

  vipLevel Int @default(0)

  rewards Reward[]
  clicks  ReferralClick[] @relation("ClickReferrer")

  @@index([role])
}

model ReferralClick {
  id           String @id @default(cuid())
  referralCode String
  referrerId   String

  // Opaque random id stored in the visitor's attribution cookie. We look the
  // referrer up from this server-side, so the client can never forge who gets
  // credited. Deliberately NOT the referral code.
  sessionId   String
  landingPage String
  userAgent   String?

  createdAt DateTime @default(now())

  referrer User @relation("ClickReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referralCode])
  @@index([referrerId])
  @@index([sessionId])
  @@index([createdAt])
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referredUserId String         @unique // a user can be referred at most once
  referralCode   String
  status         ReferralStatus @default(REGISTERED)

  createdAt    DateTime  @default(now())
  registeredAt DateTime?
  qualifiedAt  DateTime?
  completedAt  DateTime?

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  // At most one reward per referral. This is the real guarantee behind
  // "a reward is never created twice" -- see the reward service.
  reward Reward?
  events ReferralEvent[]

  @@index([referrerId])
  @@index([status])
  @@index([createdAt])
}

model Reward {
  id         String       @id @default(cuid())
  referralId String       @unique // one reward per referral, enforced by the DB
  userId     String // the referrer who earns it
  amount     Int // whole USD, V1 = 500
  currency   String       @default("USD")
  status     RewardStatus @default(PENDING)
  reason     String

  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  paidAt     DateTime?

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ReferralEvent {
  id         String            @id @default(cuid())
  referralId String
  eventType  ReferralEventType
  // Small JSON blob of context (amounts, actor, previous status...). Kept
  // loose on purpose: the audit trail should be able to record anything.
  metadata   Json?
  createdAt  DateTime          @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([eventType])
  @@index([createdAt])
}
